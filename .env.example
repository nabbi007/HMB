# Root env for docker-compose.prod.yml (compose interpolates these).
# Copy to .env and fill in. This file (.env) is gitignored.

# --- Database (the db container is created with these) ---
POSTGRES_USER=hmb
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=hmb

# --- Public origin the app is served from ---
# For a quick IP demo:      http://<EC2_PUBLIC_IP>
# With a domain + HTTPS:     https://app.hellomamabetter.com
PUBLIC_ORIGIN=http://CHANGE_ME_public_ip_or_domain

# --- Mapbox token (baked into the frontend at build time) ---
VITE_MAPBOX_TOKEN=pk.CHANGE_ME
