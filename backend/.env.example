# Copy to .env and adjust for local dev.
ENVIRONMENT=development
DEBUG=true

# When running via docker-compose, host is "db"; locally it's "localhost".
DATABASE_URL=postgresql+psycopg://hmb:hmb@localhost:5432/hmb

JWT_SECRET=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000

# Nurse PIN encryption. Generate PIN_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank in dev to use the built-in fallback key (do NOT do that in prod).
PIN_ENCRYPTION_KEY=
PIN_INDEX_KEY=change-me-too

# Email / SMTP — dev uses Mailpit (SMTP on 1025, web UI on http://localhost:8025).
# In docker-compose the host is "mailpit"; running locally it's "localhost".
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HelloMamaBetter <no-reply@hmb.app>
SMTP_STARTTLS=false

# Optional
SENTRY_DSN=
