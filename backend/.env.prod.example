# Backend runtime secrets for production (env_file for the api container).
# Copy to backend/.env.prod and fill in. That file is gitignored.
# NOTE: DATABASE_URL and CORS_ORIGINS are injected by docker-compose.prod.yml
# from the root .env — do NOT set them here.

ENVIRONMENT=production
DEBUG=false

# --- Auth ---
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_random_48_chars

# --- Nurse PIN crypto ---
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIN_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Blind-index HMAC key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PIN_INDEX_KEY=CHANGE_ME_random_32_chars

# --- Email (Gmail SMTP; same as dev) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hellomamabetter@gmail.com
SMTP_PASSWORD=CHANGE_ME_gmail_app_password
SMTP_FROM=HelloMamaBetter <hellomamabetter@gmail.com>
SMTP_STARTTLS=true
SMTP_SSL=false
